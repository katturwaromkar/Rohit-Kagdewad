# Environment Variables for Rohit Kagdewad Lending Management System

# Production Database (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rohit_lending?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/rohit_lending?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# JWT & Authentication Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="change-this-to-a-secure-random-secret-key-32-chars-min"
JWT_EXPIRATION="7d"

# Business Information Defaults
NEXT_PUBLIC_BUSINESS_NAME="Rohit Kagdewad Lending Management"
NEXT_PUBLIC_BUSINESS_OWNER="Rohit Kagdewad"
NEXT_PUBLIC_BUSINESS_PHONE="+91 96652 69105"
NEXT_PUBLIC_BUSINESS_CITY="Nanded, Maharashtra"
NEXT_PUBLIC_CURRENCY_SYMBOL="₹"
NEXT_PUBLIC_TIMEZONE="Asia/Kolkata"

# WhatsApp Business Cloud API (Official Meta Graph API)
# Get from developers.facebook.com -> WhatsApp -> API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v20.0"

# Vercel Cron Secret (Guards /api/cron/reminders)
CRON_SECRET="secure-cron-trigger-secret-token"

# Supabase Storage (Optional for document uploads)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
